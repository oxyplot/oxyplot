<Window x:Class="Demo_OxyPlotControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:oxyControls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
        mc:Ignorable="d"
        Title="OxyPlot Controls Demo - Comprehensive Series Demonstrations" Height="800" Width="1400"
        x:Name="MainWindowRoot">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="350" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="LightGray" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Demo Type:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="DemoTypeComboBox"
                          Width="200"
                          SelectedIndex="0"
                          SelectionChanged="DemoTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Line Series"/>
                    <ComboBoxItem Content="Scatter Series"/>
                    <ComboBoxItem Content="Area Series"/>
                    <ComboBoxItem Content="Histogram Series"/>
                    <ComboBoxItem Content="Column Series"/>
                    <ComboBoxItem Content="Bar Series"/>
                    <ComboBoxItem Content="Box Plot Series"/>
                    <ComboBoxItem Content="Heat Map Series"/>
                    <ComboBoxItem Content="Scatter Error Series"/>
                    <ComboBoxItem Content="DateTime Series"/>
                </ComboBox>

                <Separator Margin="20,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Content="💾 Save Settings"
                        Click="SaveSettings_Click"
                        Padding="10,4"
                        Margin="0,0,5,0"
                        ToolTip="Save plot appearance settings to XML"/>

                <Button Content="📂 Load Settings"
                        Click="LoadSettings_Click"
                        Padding="10,4"
                        ToolTip="Load plot appearance settings from XML"/>
            </StackPanel>
        </Border>

        <!-- Plot Area with Interactive Toolbar -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- PlotView (Center) -->
            <oxy:PlotView x:Name="PlotView"
                          Grid.Column="0"
                          Model="{Binding PlotModel, ElementName=MainWindowRoot}"/>

            <!-- Interactive Toolbar (Right of Plot, Vertical) -->
            <oxyControls:OxyPlotToolbar Grid.Column="1"
                                        x:Name="PlotToolbar"
                                        PlotView="{Binding ElementName=PlotView}"
                                        Orientation="Vertical"
                                        Margin="4,0,0,0"
                                        ToolTip="Interactive plot tools: Pan, Zoom, Annotations, Export"/>
        </Grid>

        <!-- Vertical GridSplitter -->
        <GridSplitter Grid.Row="1"
                      Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      Background="Gray"/>

        <!-- Properties Panel (Right Side) -->
        <Grid Grid.Row="1" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="DarkSlateGray"
                    Padding="10">
                <TextBlock Text="PLOT PROPERTIES"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Complete Properties Control -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <oxyControls:OxyplotPropertiesControl x:Name="PropertiesControl"
                                                      Model="{Binding PlotModel, ElementName=MainWindowRoot}"
                                                      Margin="5"/>
            </ScrollViewer>

            <!-- Status Footer -->
            <Border Grid.Row="2"
                    BorderBrush="Gray"
                    BorderThickness="0,1,0,0"
                    Background="WhiteSmoke"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="STATUS"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="DarkSlateGray"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatusText"
                               Text="Ready - Select a demo type from the dropdown above"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="Green"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
