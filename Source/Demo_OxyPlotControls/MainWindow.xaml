<Window x:Class="Demo_OxyPlotControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:controls="clr-namespace:OxyPlotControls.Controls.General;assembly=OxyPlotControls"
        xmlns:oxyControls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
        mc:Ignorable="d"
        Title="OxyPlot Controls Demo - Full Interactive Toolbar" Height="800" Width="1400"
        x:Name="MainWindowRoot">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Interactive Plot with Toolbar -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Data Management Toolbar (simplified) -->
            <ToolBarTray Grid.Row="0" Background="LightGray">
                <ToolBar Header="Data">
                    <Button Content="Add Line Series" Click="AddLineSeries_Click" Padding="8,4"/>
                    <Button Content="Add Bar Series" Click="AddBarSeries_Click" Padding="8,4"/>
                    <Separator/>
                    <Button Content="Clear Series" Click="ClearSeries_Click" Padding="8,4"/>
                    <Separator/>
                    <Button Content="Save Settings" Click="SaveSettings_Click" Padding="8,4"/>
                    <Button Content="Load Settings" Click="LoadSettings_Click" Padding="8,4"/>
                </ToolBar>
            </ToolBarTray>

            <!-- Interactive Plot Toolbar with Embedded PlotView -->
            <oxyControls:OxyPlotToolbar Grid.Row="1" x:Name="PlotToolbar">
                <oxyControls:OxyPlotToolbar.PlotView>
                    <oxy:PlotView x:Name="PlotView"
                                  Model="{Binding PlotModel, ElementName=MainWindowRoot}"/>
                </oxyControls:OxyPlotToolbar.PlotView>
            </oxyControls:OxyPlotToolbar>
        </Grid>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Background="Gray"/>

        <!-- Properties Panel -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="PLOT PROPERTIES"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <controls:GeneralPlotControl
                    x:Name="GeneralControl"
                    Model="{Binding PlotModel, ElementName=MainWindowRoot}"/>

                <TextBlock Text="STATUS"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,20,0,10"/>

                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           TextWrapping="Wrap"
                           Foreground="Green"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
