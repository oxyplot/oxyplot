<Window x:Class="Demo_OxyPlotControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:oxyControls="clr-namespace:OxyPlotControls;assembly=OxyPlotControls"
        mc:Ignorable="d"
        Title="OxyPlot Controls Demo - Comprehensive Series and Axis Demonstrations" Height="850" Width="1500"
        x:Name="MainWindowRoot">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition x:Name="PropertiesColumn" Width="380" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="4" Background="#FFE8E8E8" Padding="10,5" BorderBrush="Gray" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Demo Type:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="DemoTypeComboBox"
                          Width="220"
                          SelectedIndex="0"
                          SelectionChanged="DemoTypeComboBox_SelectionChanged">
                    <!-- Line Series Demos -->
                    <ComboBoxItem Content="Line Series"/>
                    <ComboBoxItem Content="Line Series (Data Bound)"/>
                    <!-- Scatter Series Demos -->
                    <ComboBoxItem Content="Scatter Series"/>
                    <ComboBoxItem Content="Scatter Series (Data Bound)"/>
                    <!-- Area Series Demos -->
                    <ComboBoxItem Content="Area Series"/>
                    <ComboBoxItem Content="Area Series (Data Bound)"/>
                    <!-- Histogram Series Demo -->
                    <ComboBoxItem Content="Histogram Series"/>
                    <!-- Column Series Demos -->
                    <ComboBoxItem Content="Column Series"/>
                    <ComboBoxItem Content="Column Series (Data Bound)"/>
                    <!-- Bar Series Demos -->
                    <ComboBoxItem Content="Bar Series"/>
                    <ComboBoxItem Content="Bar Series (Data Bound)"/>
                    <!-- Box Plot Series Demo -->
                    <ComboBoxItem Content="Box Plot Series"/>
                    <!-- Heat Map Series Demo -->
                    <ComboBoxItem Content="Heat Map Series"/>
                    <!-- Scatter Error Series Demo -->
                    <ComboBoxItem Content="Scatter Error Series"/>
                    <!-- DateTime Series Demo -->
                    <ComboBoxItem Content="DateTime Series"/>
                    <!-- Logarithmic Axis Demo -->
                    <ComboBoxItem Content="Logarithmic Axis"/>
                    <!-- Annotations Demo -->
                    <ComboBoxItem Content="Annotations Demo"/>
                    <!-- Multiple Axes Demo -->
                    <ComboBoxItem Content="Multiple Axes"/>
                </ComboBox>

                <Separator Margin="20,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <Button Content="Save Settings"
                        Click="SaveSettings_Click"
                        Padding="10,4"
                        Margin="0,0,5,0"
                        ToolTip="Save plot appearance settings to XML"/>

                <Button Content="Load Settings"
                        Click="LoadSettings_Click"
                        Padding="10,4"
                        Margin="0,0,5,0"
                        ToolTip="Load plot appearance settings from XML"/>

                <Separator Margin="20,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>

                <CheckBox x:Name="ShowPropertiesCheckBox"
                          Content="Show Properties Panel"
                          IsChecked="True"
                          Checked="ShowPropertiesCheckBox_Changed"
                          Unchecked="ShowPropertiesCheckBox_Changed"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0"/>

                <Button Content="Refresh Plot"
                        Click="RefreshPlot_Click"
                        Padding="10,4"
                        ToolTip="Refresh the plot display"/>
            </StackPanel>
        </Border>

        <!-- Plot Area with Interactive Toolbar -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- PlotView (Center) -->
            <oxy:PlotView x:Name="PlotView"
                          Grid.Column="0"
                          Model="{Binding PlotModel, ElementName=MainWindowRoot}"/>

            <!-- Interactive Toolbar (Right of Plot, Vertical) -->
            <oxyControls:OxyPlotToolbar Grid.Column="1"
                                        x:Name="PlotToolbar"
                                        PlotView="{Binding ElementName=PlotView}"
                                        Orientation="Vertical"
                                        Margin="4,0,0,0"
                                        PropertiesCalled="PlotToolbar_PropertiesCalled"
                                        ToolTip="Interactive plot tools: Pan, Zoom, Annotations, Export"/>
        </Grid>

        <!-- Vertical GridSplitter -->
        <GridSplitter Grid.Row="1"
                      Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      Background="Gray"/>

        <!-- Properties Panel (Right Side) -->
        <Grid x:Name="PropertiesPanel" Grid.Row="1" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="DarkSlateGray"
                    Padding="10">
                <Grid>
                    <TextBlock Text="PLOT PROPERTIES"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Content="X"
                            HorizontalAlignment="Right"
                            Width="24"
                            Height="24"
                            Click="ClosePropertiesPanel_Click"
                            ToolTip="Close properties panel"
                            Background="Transparent"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- Complete Properties Control -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <oxyControls:OxyplotPropertiesControl x:Name="PropertiesControl"
                                                      Model="{Binding PlotModel, ElementName=MainWindowRoot}"
                                                      ShowCloseButton="False"
                                                      ClosePropertiesCalled="PropertiesControl_ClosePropertiesCalled"
                                                      Margin="5"/>
            </ScrollViewer>

            <!-- Status Footer -->
            <Border Grid.Row="2"
                    BorderBrush="Gray"
                    BorderThickness="0,1,0,0"
                    Background="WhiteSmoke"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="STATUS"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="DarkSlateGray"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatusText"
                               Text="Ready - Select a demo type from the dropdown above"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="Green"/>
                    <TextBlock x:Name="StatsText"
                               Text=""
                               TextWrapping="Wrap"
                               FontSize="10"
                               Foreground="DarkGray"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
