<UserControl x:Class="LineSeriesControl" x:Name="LineSeriesProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OxyplotControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/IconResources.xaml"/>
                <ResourceDictionary>
                    <cntrls:FontFamilyToFontStringConverter x:Key="FontFamilyToFontConverter"/>
                    <cntrls:AlwaysVisibleConverter x:Key="AlwaysVisibleConverter" />
                    <local:LineSeriesColorConverter x:Key="LineColorConverter"/>
                    <!--<local:AreaSeriesColor2Converter x:Key="LineColor2Converter"/>-->
                    <local:AreaSeriesFillConverter x:Key="AreaFillConverter"/>
                    <local:LineSeriesMarkerFillConverter x:Key="MarkerFillConverter"/>
                    <local:LineSeriesMarkerStrokeConverter x:Key="MarkerStrokeConverter"/>
                    <local:OxyLineStyleToDashArrayConverter x:Key="LineStyleConverter"/>
                    <local:OxyDefaultFontSizeConverter x:Key="DefaultFontSizeConverter"/>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                    <cntrls:VisibilityToBooleanConverter x:Key="VisibilityToBoolConverter" VisibleValue="True" CollapsedValue="False" HiddenValue="False"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <cntrls:ContentPropertyControl 
            Name="DummyPropertyControl" 
            Grid.Row="0" 
            Visibility="Hidden" 
            Title="Marker Line Thickness" 
            Padding="6 0 0 0"/>

        <!--General-->
        <!--<Expander 
            x:Name="LabelingEXP" 
            Grid.Row="1" Margin="0,0,0,0" 
            Header="GENERAL" 
            IsExpanded="True" 
            DockPanel.Dock="Top" 
            Template="{StaticResource ExpanderControlTemplate1}">

            <DockPanel>


                LineLegendPosition (LineSeries Only) DEVELOPER)
                <local:LineLegendPositionPropertyControl 
                    <cntrls:ContentPropertyControl 
                            Title="Line Legend Position" 
                            Margin="0 2" 
                            DockPanel.Dock="Top" 
                            PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                            Visibility="{Binding Series.LineLegendPosition, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}">
                    <cntrls:ContentPropertyControl.InnerContent>
                        <ComboBox  
                            ItemsSource="{Binding LineLegendPositionOptions}" 
                            SelectedValue="{Binding Path=Series.LineLegendPosition, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </cntrls:ContentPropertyControl.InnerContent>
                    </cntrls:ContentPropertyControl>

                    Series Font
                    <cntrls:FontSelectorControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Font" 
                    FontFamilyString="{Binding Path=Series.FontFamily, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource FontFamilyToFontConverter}}"
                    PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                    Series Font Size
                    <cntrls:NumericPropertySelectorControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Font Size" 
                    CanHaveNegative="False" 
                    NumericOptions="{StaticResource FontSizeOptions}" 
                    SelectedNumber="{Binding Series.FontSize, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DefaultFontSizeConverter}}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                    Font Weight (DEVELOPER)
                    <cntrls:FontWeightSelectorControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Font Weight" 
                    SelectedFontWeight="{Binding Path=Series.FontWeight, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                    LabelFormatString (LineSeries Only), default is null
                LabelMargin (LineSeries Only), default is 6
                LabelPlacement (BarSeries Only)

                Series Foreground (used for text color)
                    <cntrls:ColorPropertyControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Text Color" 
                    SelectedColor="{Binding ElementName=LineSeriesProperties, Path=Series.Foreground, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    X Axis Key (XYAxisSeries Only) (DEVELOPER)
                    <cntrls:TextPropertyControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="X-Axis Key" 
                    Text="{Binding Series.XAxisKey, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource EmptyToNullConverter}}" 
                        Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.XAxisKey, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>

                    Y Axis Key (XYAxisSeries Only) (DEVELOPER)
                    <cntrls:TextPropertyControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Y-Axis Key" 
                    Text="{Binding Series.YAxisKey, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource EmptyToNullConverter}}" 
                        Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.YAxisKey, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>

                    Tracker Interpolates (DataPointSeries Only) (DEVELOPER)
                    <cntrls:BooleanPropertyControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Interpolate Tracker" 
                    IsSelected="{Binding ElementName=LineSeriesProperties, Path=Series.CanTrackerInterpolatePoints, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                        Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.CanTrackerInterpolatePoints, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>

                    DataFieldX (DataPointSeries Only)
                DataFieldY (DataPointSeries Only)
                Mapping (DataPointSeries Only)

            </DockPanel>

        </Expander>-->

        <!--Display-->
        <Expander 
                x:Name="DisplayEXP" 
                Grid.Row="1" Margin="0,0,0,0" 
                Header="DISPLAY" 
                IsExpanded="True" 
                DockPanel.Dock="Top" 
                Style="{Binding ElementName=LineSeriesProperties, Path=ExpanderStyle}">

            <DockPanel>

                <!--Title Text-->
                <cntrls:TextPropertyControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="400"
                    Title="Title" 
                    Text="{Binding Series.Title, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                <!--Visibility (DEVELOPER)-->
                <cntrls:BooleanPropertyControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Is Visible" 
                    IsSelected="{Binding ElementName=LineSeriesProperties, Path=Series.Visibility, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource VisibilityToBoolConverter}}"/>

                <!--Render In Legend (DEVELOPER)-->
                <cntrls:BooleanPropertyControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Show In Legend" 
                    IsSelected="{Binding ElementName=LineSeriesProperties, Path=Series.RenderInLegend, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                <!--Series Color-->
                <cntrls:ColorPropertyControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Line Color">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding 
                                Converter="{StaticResource LineColorConverter}" 
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding 
                                    Path="Series.Color" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="TwoWay"/>
                            <Binding 
                                    Path="Series" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--Area Series Color2 (Defaults to Color so leaving it out)-->
                <!--<cntrls:ColorPropertyControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Second Line Color"
                        Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.Color2, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding 
                                Converter="{StaticResource LineColor2Converter}" 
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding 
                                    Path="Series.Color2" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="TwoWay"/>
                            <Binding 
                                    Path="Series" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>-->

                <!--Area Series Fill-->
                <cntrls:ColorPropertyControl 
                    Margin="0 2" 
                    DockPanel.Dock="Top" 
                    Title="Fill"
                    Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.Fill, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding 
                                Converter="{StaticResource AreaFillConverter}" 
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding 
                                    Path="Series.Fill" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="TwoWay"/>
                            <Binding 
                                    Path="Series" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--Dashes (LineSeries Only) overrides the linestyle property, default is null-->
                <!--Decimator (LineSeries Only) action used to decimate screenpoints generally for improving render performance.-->

                <!--LineJoin (LineSeries Only)-->

                <!--<cntrls:ContentPropertyControl 
                            Title="Join Style" 
                            Margin="0 2" 
                            DockPanel.Dock="Top" 
                            PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                    <cntrls:ContentPropertyControl.InnerContent>
                        <ComboBox  
                            ItemsSource="{Binding LineJoinOptions}" 
                            SelectedValue="{Binding Path=Series.LineJoin, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </cntrls:ContentPropertyControl.InnerContent>
                </cntrls:ContentPropertyControl>-->

                <!--LineStyle (LineSeries and BoxPlotSeries Only)-->
                <cntrls:LineStyleSelectorControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Line Style" 
                        DashArrayOptions="{Binding ElementName=LineSeriesProperties, Path=LineStyleOptions}" 
                        SelectedDashArray="{Binding ElementName=LineSeriesProperties, Path=Series.LineStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource LineStyleConverter}}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--StrokeThickness (LineSeries And BoxPlotSeries BarSeries)-->
                <cntrls:LineWidthSelectorControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Line Thickness" 
                        WidthOptions="{StaticResource LineWidthOptions}" SelectedWidth="{Binding Series.StrokeThickness, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

            </DockPanel>

        </Expander>

        <!--Markers-->
        <Expander 
                x:Name="MarkersEXP" 
                Grid.Row="3" Margin="0,0,0,0" 
                Header="MARKERS" 
                IsExpanded="True" 
                DockPanel.Dock="Top" 
                Style="{Binding ElementName=LineSeriesProperties, Path=ExpanderStyle}">

            <DockPanel 
                        Grid.Row="2">

                <!--MarkerType (LineSeries and ScatterSeries)-->
                <cntrls:ContentPropertyControl 
                            Title="Marker" 
                            Margin="0 2" 
                            DockPanel.Dock="Top" 
                            PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                    <cntrls:ContentPropertyControl.InnerContent>
                        <ComboBox  
                            ItemsSource="{Binding MarkerTypeOptions}" 
                            SelectedValue="{Binding Path=Series.MarkerType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </cntrls:ContentPropertyControl.InnerContent>
                </cntrls:ContentPropertyControl>

                <!--MarkerFill (LineSeries and ScatterSeries)-->
                <cntrls:ColorPropertyControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Marker Fill">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding 
                                Converter="{StaticResource MarkerFillConverter}" 
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding 
                                    Path="Series.MarkerFill" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="TwoWay"/>
                            <Binding 
                                    Path="Series" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--MarkerOutline (LineSeries and ScatterSeries) Allows capability to define custom polygon outline for the markers, default is null-->

                <!--MarkerResolution (LineSeries Only) Allows defining resolution of the markers. It appears that the higher the number the lower the resolution and faster the rendering, default is 0-->
                <!--<cntrls:NumericPropertySelectorControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Marker Resolution" 
                        CanHaveNegative="False" 
                        ToolTip="High value equals lower resolution but faster display rendering." 
                        NumericOptions="{StaticResource LineWidthOptions}" SelectedNumber="{Binding ElementName=LineSeriesProperties, Path=Series.MarkerResolution, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>-->

                <!--MarkerSize (LineSeries and ScatterSeries)-->
                <cntrls:NumericPropertySelectorControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Marker Size" 
                        CanHaveNegative="False" 
                        NumericOptions="{StaticResource LineWidthOptions}" 
                        SelectedNumber="{Binding ElementName=LineSeriesProperties, Path=Series.MarkerSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--MarkerStroke (LineSeries and ScatterSeries)-->
                <cntrls:ColorPropertyControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Marker Line Color">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding 
                                Converter="{StaticResource MarkerStrokeConverter}" 
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding 
                                    Path="Series.MarkerStroke" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="TwoWay"/>
                            <Binding 
                                    Path="Series" 
                                    ElementName="LineSeriesProperties" 
                                    UpdateSourceTrigger="PropertyChanged" 
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--MarkerStrokeThickness (LineSeries and ScatterSeries)-->
                <cntrls:LineWidthSelectorControl 
                        Margin="0 2" 
                        DockPanel.Dock="Top" 
                        Title="Marker Line Thickness" 
                        WidthOptions="{StaticResource LineWidthOptions}" 
                        SelectedWidth="{Binding Series.MarkerStrokeThickness, 
                        ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

            </DockPanel>

        </Expander>


        <!--<cntrls:SeparatorWithHeader Header="Broken Line Display" DockPanel.Dock="Top" Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.BrokenLineColor, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>-->
        <!--BrokenLineColor (LineSeries Only)-->
        <!--
                <cntrls:ColorPropertyControl Margin="0 2" DockPanel.Dock="Top" Title="Broken Line Color" SelectedColor="{Binding ElementName=LineSeriesProperties, Path=Series.BrokenLineColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource OxyAutoColorConverter}}" Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.CanTrackerInterpolatePoints, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>

                -->
        <!--BrokenLineStyle (LineSeries Only)-->
        <!--
                <cntrls:LineStyleSelectorControl Margin="0 2" DockPanel.Dock="Top" Title="Broken Line Style" DashArrayOptions="{Binding ElementName=LineSeriesProperties, Path=LineStyleOptions}" SelectedDashArray="{Binding ElementName=LineSeriesProperties, Path=Series.BrokenLineStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource LineStyleConverter}}" Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.BrokenLineStyle, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>

                -->
        <!--BrokenLineThickness (LineSeries Only)-->
        <!--
                <cntrls:LineWidthSelectorControl Margin="0 2" DockPanel.Dock="Top" Title="Broken Line Thickness" WidthOptions="{StaticResource LineWidthOptions}" SelectedWidth="{Binding Series.BrokenlineThickness, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.BrokenLineThickness, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>-->

    </Grid>
</UserControl>
