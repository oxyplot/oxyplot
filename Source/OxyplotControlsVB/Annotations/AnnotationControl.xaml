                            Title="Maximum X" 
                            Number="{Binding ElementName=AnnotationProperties, Path=Annotation.MaximumX, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"        
                            Visibility="{Binding ElementName=AnnotationProperties, Path=Annotation.MaximumX, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}" 
