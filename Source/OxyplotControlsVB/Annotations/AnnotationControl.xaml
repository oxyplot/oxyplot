                            PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"  
                            Visibility="{Binding ElementName=AnnotationProperties, Path=Annotation.MinimumY, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}" 
                            IsEnabled="{Binding ElementName=AnnotationProperties, Path=Annotation.IsEnabled}"/>-->

                <!--ClipByXAxis (PathAnnotation Only) (DEVELOPER)-->
                <!--<cntrls:BooleanPropertyControl 
                            Margin="0 2" 
                            DockPanel.Dock="Top" 
                            Title="Clip By X-Axis" 
                            IsSelected="{Binding ElementName=AnnotationProperties, Path=Annotation.ClipByXAxis, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                            Visibility="{Binding ElementName=AnnotationProperties, Path=Annotation.ClipByXAxis, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}" 
                            IsEnabled="{Binding ElementName=AnnotationProperties, Path=Annotation.IsEnabled}"/>-->

                <!--ClipByYAxis (PathAnnotation Only) (DEVELOPER)-->
                <!--<cntrls:BooleanPropertyControl 
                            Margin="0 2" 
                            DockPanel.Dock="Top" 
