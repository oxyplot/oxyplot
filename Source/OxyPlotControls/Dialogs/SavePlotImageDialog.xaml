<Window x:Class="OxyPlotControls.Dialogs.SavePlotImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Plot Image" SizeToContent="Height" Width="200"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize" ShowInTaskbar="False"
        x:Name="DialogRoot">
    <Grid Margin="15,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Size Preset Selector -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Image Size:" Margin="0,0,0,5"/>
        <ComboBox x:Name="ImageSizeComboBox"
                  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                  Margin="0,0,0,10"
                  SelectedIndex="0"
                  SelectionChanged="ImageSizeComboBox_SelectionChanged">
            <ComboBoxItem Content="600 x 480 (5:4)"/>
            <ComboBoxItem Content="1000 x 800 (5:4)"/>
            <ComboBoxItem Content="600 x 450 (4:3)"/>
            <ComboBoxItem Content="1000 x 750 (4:3)"/>
            <ComboBoxItem Content="1280 x 720 (16:9)"/>
            <ComboBoxItem Content="1920 x 1080 (16:9)"/>
            <ComboBoxItem Content="800 x 800 (1:1)"/>
            <ComboBoxItem Content="1080 x 1080 (1:1)"/>
            <ComboBoxItem Content="500 x 800 (2.5:4)"/>
            <ComboBoxItem Content="Custom"/>
        </ComboBox>

        <!-- Width -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Width:"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>
        <TextBox x:Name="WidthTextBox"
                 Grid.Row="2" Grid.Column="1"
                 Width="80"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="0,5"
                 PreviewTextInput="TextBox_PreviewTextInput"
                 IsEnabled="False"
                 ToolTipService.ShowOnDisabled="True"/>
        <TextBlock Grid.Row="2" Grid.Column="2"
                   Text=" px"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

        <!-- Height -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Height:"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"/>
        <TextBox x:Name="HeightTextBox"
                 Grid.Row="3" Grid.Column="1"
                 Width="80"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="0,5"
                 PreviewTextInput="TextBox_PreviewTextInput"
                 IsEnabled="False"
                 ToolTipService.ShowOnDisabled="True"/>
        <TextBlock Grid.Row="3" Grid.Column="2"
                   Text=" px"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>

        <!-- Save Button -->
        <Button x:Name="SaveButton"
                Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                Content="Save"
                Margin="0,15,0,5"
                Height="25"
                Width="100"
                HorizontalAlignment="Center"
                Click="SaveButton_Click"/>
    </Grid>
</Window>
