<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ExpanderStyle.xaml"/>
        <ResourceDictionary Source="TabItemStyle.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Clean Button Style for back/close buttons -->
    <Style x:Key="CleanButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFdeeeff" TargetName="Border"/>
                            <Setter Property="BorderBrush" Value="#FFD9ECFF" TargetName="Border"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox Resources -->
    <SolidColorBrush x:Key="OxyComboStatic.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="OxyComboStatic.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="OxyComboMouseOver.Glyph" Color="#FF000000"/>
    <LinearGradientBrush x:Key="OxyComboMouseOver.Background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFECF4FC" Offset="0.0"/>
        <GradientStop Color="#FFDCECFC" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OxyComboMouseOver.Border" Color="#FF7EB4EA"/>
    <SolidColorBrush x:Key="OxyComboPressed.Glyph" Color="#FF000000"/>
    <LinearGradientBrush x:Key="OxyComboPressed.Background" EndPoint="0,1" StartPoint="0,0">
        <GradientStop Color="#FFDAECFC" Offset="0.0"/>
        <GradientStop Color="#FFC4E0FC" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OxyComboPressed.Border" Color="#FF569DE5"/>
    <SolidColorBrush x:Key="OxyComboDisabled.Glyph" Color="#FFBFBFBF"/>
    <SolidColorBrush x:Key="OxyComboDisabled.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="OxyComboDisabled.Border" Color="#FFD9D9D9"/>
    <SolidColorBrush x:Key="OxyComboStatic.Glyph" Color="#FF606060"/>

    <!-- Clean ComboBox Toggle Button -->
    <Style x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="templateRoot"
                            BorderBrush="{StaticResource OxyComboStatic.Border}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{StaticResource OxyComboStatic.Background}"
                            SnapsToDevicePixels="true">
                        <Border x:Name="splitBorder"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                Margin="0"
                                SnapsToDevicePixels="True"
                                Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}">
                            <Path x:Name="arrow"
                                  Data="M 0 0 L 4 6 L 8 0 Z"
                                  Fill="{StaticResource OxyComboStatic.Glyph}"
                                  HorizontalAlignment="Center"
                                  Margin="0"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Fill" TargetName="arrow" Value="{StaticResource OxyComboMouseOver.Glyph}"/>
                            <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource OxyComboMouseOver.Background}"/>
                            <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource OxyComboMouseOver.Border}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Fill" TargetName="arrow" Value="{StaticResource OxyComboPressed.Glyph}"/>
                            <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource OxyComboPressed.Background}"/>
                            <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource OxyComboPressed.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Fill" TargetName="arrow" Value="{StaticResource OxyComboDisabled.Glyph}"/>
                            <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource OxyComboDisabled.Background}"/>
                            <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource OxyComboDisabled.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean ComboBox Style -->
    <Style x:Key="CleanComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{StaticResource OxyComboStatic.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OxyComboStatic.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Padding" Value="6,3,5,3"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
    </Style>

    <!-- Common Option Arrays -->
    <x:Array Type="{x:Type sys:Double}" x:Key="FontSizeOptions" xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <sys:Double>8</sys:Double>
        <sys:Double>9</sys:Double>
        <sys:Double>10</sys:Double>
        <sys:Double>11</sys:Double>
        <sys:Double>12</sys:Double>
        <sys:Double>14</sys:Double>
        <sys:Double>16</sys:Double>
        <sys:Double>18</sys:Double>
        <sys:Double>20</sys:Double>
        <sys:Double>22</sys:Double>
        <sys:Double>24</sys:Double>
        <sys:Double>26</sys:Double>
        <sys:Double>28</sys:Double>
        <sys:Double>36</sys:Double>
        <sys:Double>48</sys:Double>
        <sys:Double>72</sys:Double>
    </x:Array>

    <x:Array Type="{x:Type sys:Double}" x:Key="LineWidthOptions" xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <sys:Double>0</sys:Double>
        <sys:Double>1</sys:Double>
        <sys:Double>2</sys:Double>
        <sys:Double>3</sys:Double>
        <sys:Double>4</sys:Double>
        <sys:Double>5</sys:Double>
        <sys:Double>7</sys:Double>
        <sys:Double>10</sys:Double>
    </x:Array>

    <x:Array Type="{x:Type sys:Double}" x:Key="PaddingOptions" xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <sys:Double>-4</sys:Double>
        <sys:Double>-2</sys:Double>
        <sys:Double>0</sys:Double>
        <sys:Double>1</sys:Double>
        <sys:Double>2</sys:Double>
        <sys:Double>3</sys:Double>
        <sys:Double>4</sys:Double>
        <sys:Double>6</sys:Double>
        <sys:Double>8</sys:Double>
        <sys:Double>10</sys:Double>
        <sys:Double>14</sys:Double>
        <sys:Double>18</sys:Double>
        <sys:Double>22</sys:Double>
        <sys:Double>26</sys:Double>
        <sys:Double>30</sys:Double>
    </x:Array>

    <x:Array Type="{x:Type sys:Double}" x:Key="AngleOptions" xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <sys:Double>0</sys:Double>
        <sys:Double>15</sys:Double>
        <sys:Double>30</sys:Double>
        <sys:Double>45</sys:Double>
        <sys:Double>60</sys:Double>
        <sys:Double>75</sys:Double>
        <sys:Double>90</sys:Double>
        <sys:Double>180</sys:Double>
        <sys:Double>270</sys:Double>
        <sys:Double>360</sys:Double>
    </x:Array>
</ResourceDictionary>
