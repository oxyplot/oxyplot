<UserControl x:Class="OxyPlotControls.BarSeriesControl" x:Name="BarSeriesProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OxyPlotControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/IconResources.xaml"/>
                <ResourceDictionary>
                    <cntrls:FontFamilyToFontStringConverter x:Key="FontFamilyToFontConverter"/>
                    <local:BarSeriesFillConverter x:Key="FillColorConverter"/>
                    <local:OxyAutomaticColorConverter x:Key="OxyAutoColorConverter"/>
                    <cntrls:AlwaysVisibleConverter x:Key="AlwaysVisibleConverter" />
                    <local:OxyDefaultFontSizeConverter x:Key="DefaultFontSizeConverter"/>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                    <cntrls:VisibilityToBooleanConverter x:Key="VisibilityToBoolConverter" VisibleValue="True" CollapsedValue="False" HiddenValue="False"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <cntrls:ContentPropertyControl
            Name="DummyPropertyControl"
            Grid.Row="0"
            Visibility="Hidden"
            Title="Line Thickness"
            Padding="6 0 0 0"/>

        <!--Display-->
        <Expander
            x:Name="DisplayEXP"
            Grid.Row="1"
            Margin="0,0,0,0"
            Header="DISPLAY"
            IsExpanded="True"
            DockPanel.Dock="Top"
            Style="{Binding ElementName=BarSeriesProperties, Path=ExpanderStyle}">

            <DockPanel>

                <!--Title Text-->
                <cntrls:TextPropertyControl
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="400"
                    Title="Title"
                    Text="{Binding Series.Title, ElementName=BarSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                <!--Visibility (DEVELOPER)-->
                <cntrls:BooleanPropertyControl
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Is Visible"
                    IsSelected="{Binding ElementName=BarSeriesProperties, Path=Series.Visibility, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource VisibilityToBoolConverter}}"/>

                <!--Render In Legend (DEVELOPER)-->
                <cntrls:BooleanPropertyControl
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Show In Legend"
                    IsSelected="{Binding ElementName=BarSeriesProperties, Path=Series.RenderInLegend, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                <!--FillColor (BarSeries Only)-->
                <cntrls:ColorPropertyControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Fill">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding
                                Converter="{StaticResource FillColorConverter}"
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding
                                    Path="Series.FillColor"
                                    ElementName="BarSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="TwoWay"/>
                            <Binding
                                    Path="Series"
                                    ElementName="BarSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--StrokeColor (BarSeries Only)-->
                <cntrls:ColorPropertyControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Line Color"
                        SelectedColor="{Binding ElementName=BarSeriesProperties, Path=Series.StrokeColor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource OxyAutoColorConverter}}"/>

                <!--StrokeThickness (LineSeries And BoxPlotSeries BarSeries)-->
                <cntrls:LineWidthSelectorControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Line Thickness"
                        WidthOptions="{StaticResource LineWidthOptions}" SelectedWidth="{Binding Series.StrokeThickness, ElementName=BarSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--BarWidth (BarSeries Only)-->
                <cntrls:NumericPropertySelectorControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Bar Width"
                        CanHaveNegative="False"
                        NumericOptions="{StaticResource LineWidthOptions}"
                        SelectedNumber="{Binding ElementName=BarSeriesProperties, Path=Series.BarWidth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                        Visibility="{Binding ElementName=BarSeriesProperties, Path=Series.BarWidth, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>

                <!--ColumnWidth (ColumnSeries Only)-->
                <cntrls:NumericPropertySelectorControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Column Width"
                        CanHaveNegative="False"
                        NumericOptions="{StaticResource LineWidthOptions}"
                        SelectedNumber="{Binding ElementName=BarSeriesProperties, Path=Series.ColumnWidth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"
                        Visibility="{Binding ElementName=BarSeriesProperties, Path=Series.ColumnWidth, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}"/>
            </DockPanel>
        </Expander>

    </Grid>
</UserControl>
