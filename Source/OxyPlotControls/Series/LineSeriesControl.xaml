<UserControl x:Class="OxyPlotControls.LineSeriesControl" x:Name="LineSeriesProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OxyPlotControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/IconResources.xaml"/>
                <ResourceDictionary>
                    <cntrls:FontFamilyToFontStringConverter x:Key="FontFamilyToFontConverter"/>
                    <cntrls:AlwaysVisibleConverter x:Key="AlwaysVisibleConverter" />
                    <local:LineSeriesColorConverter x:Key="LineColorConverter"/>
                    <!--<local:AreaSeriesColor2Converter x:Key="LineColor2Converter"/>-->
                    <local:AreaSeriesFillConverter x:Key="AreaFillConverter"/>
                    <local:LineSeriesMarkerFillConverter x:Key="MarkerFillConverter"/>
                    <local:LineSeriesMarkerStrokeConverter x:Key="MarkerStrokeConverter"/>
                    <local:OxyLineStyleToDashArrayConverter x:Key="LineStyleConverter"/>
                    <local:OxyDefaultFontSizeConverter x:Key="DefaultFontSizeConverter"/>
                    <cntrls:DoubleToGridLengthConverter x:Key="ActualToLengthConverter" />
                    <cntrls:VisibilityToBooleanConverter x:Key="VisibilityToBoolConverter" VisibleValue="True" CollapsedValue="False" HiddenValue="False"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <cntrls:ContentPropertyControl
            Name="DummyPropertyControl"
            Grid.Row="0"
            Visibility="Hidden"
            Title="Marker Line Thickness"
            Padding="6 0 0 0"/>

        <!--Display-->
        <Expander
                x:Name="DisplayEXP"
                Grid.Row="1" Margin="0,0,0,0"
                Header="DISPLAY"
                IsExpanded="True"
                DockPanel.Dock="Top"
                Style="{Binding ElementName=LineSeriesProperties, Path=ExpanderStyle}">

            <DockPanel>

                <!--Title Text-->
                <cntrls:TextPropertyControl
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    MaxPropertyWidth="400"
                    Title="Title"
                    Text="{Binding Series.Title, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                <!--Visibility (DEVELOPER)-->
                <cntrls:BooleanPropertyControl
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Is Visible"
                    IsSelected="{Binding ElementName=LineSeriesProperties, Path=Series.Visibility, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource VisibilityToBoolConverter}}"/>

                <!--Render In Legend (DEVELOPER)-->
                <cntrls:BooleanPropertyControl
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Show In Legend"
                    IsSelected="{Binding ElementName=LineSeriesProperties, Path=Series.RenderInLegend, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                <!--Series Color-->
                <cntrls:ColorPropertyControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Line Color">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding
                                Converter="{StaticResource LineColorConverter}"
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding
                                    Path="Series.Color"
                                    ElementName="LineSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="TwoWay"/>
                            <Binding
                                    Path="Series"
                                    ElementName="LineSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--Area Series Fill-->
                <cntrls:ColorPropertyControl
                    Margin="0 2"
                    DockPanel.Dock="Top"
                    Title="Fill"
                    Visibility="{Binding ElementName=LineSeriesProperties, Path=Series.Fill, Converter={StaticResource AlwaysVisibleConverter}, FallbackValue=Collapsed}">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding
                                Converter="{StaticResource AreaFillConverter}"
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding
                                    Path="Series.Fill"
                                    ElementName="LineSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="TwoWay"/>
                            <Binding
                                    Path="Series"
                                    ElementName="LineSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--LineStyle (LineSeries Only)-->
                <cntrls:LineStyleSelectorControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Line Style"
                        DashArrayOptions="{Binding ElementName=LineSeriesProperties, Path=LineStyleOptions}"
                        SelectedDashArray="{Binding ElementName=LineSeriesProperties, Path=Series.LineStyle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource LineStyleConverter}}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--StrokeThickness (LineSeries And BoxPlotSeries BarSeries)-->
                <cntrls:LineWidthSelectorControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Line Thickness"
                        WidthOptions="{StaticResource LineWidthOptions}" SelectedWidth="{Binding Series.StrokeThickness, ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

            </DockPanel>

        </Expander>

        <!--Markers-->
        <Expander
                x:Name="MarkersEXP"
                Grid.Row="3" Margin="0,0,0,0"
                Header="MARKERS"
                IsExpanded="True"
                DockPanel.Dock="Top"
                Style="{Binding ElementName=LineSeriesProperties, Path=ExpanderStyle}">

            <DockPanel
                        Grid.Row="2">

                <!--MarkerType (LineSeries and ScatterSeries)-->
                <cntrls:ContentPropertyControl
                            Title="Marker"
                            Margin="0 2"
                            DockPanel.Dock="Top"
                            PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}">
                    <cntrls:ContentPropertyControl.InnerContent>
                        <ComboBox
                            ItemsSource="{Binding MarkerTypeOptions}"
                            SelectedValue="{Binding Path=Series.MarkerType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                    </cntrls:ContentPropertyControl.InnerContent>
                </cntrls:ContentPropertyControl>

                <!--MarkerFill (LineSeries and ScatterSeries)-->
                <cntrls:ColorPropertyControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Marker Fill">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding
                                Converter="{StaticResource MarkerFillConverter}"
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding
                                    Path="Series.MarkerFill"
                                    ElementName="LineSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="TwoWay"/>
                            <Binding
                                    Path="Series"
                                    ElementName="LineSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--MarkerSize (LineSeries and ScatterSeries)-->
                <cntrls:NumericPropertySelectorControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Marker Size"
                        CanHaveNegative="False"
                        NumericOptions="{StaticResource LineWidthOptions}"
                        SelectedNumber="{Binding ElementName=LineSeriesProperties, Path=Series.MarkerSize, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

                <!--MarkerStroke (LineSeries and ScatterSeries)-->
                <cntrls:ColorPropertyControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Marker Line Color">
                    <cntrls:ColorPropertyControl.SelectedColor>
                        <MultiBinding
                                Converter="{StaticResource MarkerStrokeConverter}"
                                UpdateSourceTrigger="PropertyChanged" Mode="TwoWay">
                            <Binding
                                    Path="Series.MarkerStroke"
                                    ElementName="LineSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="TwoWay"/>
                            <Binding
                                    Path="Series"
                                    ElementName="LineSeriesProperties"
                                    UpdateSourceTrigger="PropertyChanged"
                                    Mode="OneWay"/>
                        </MultiBinding>
                    </cntrls:ColorPropertyControl.SelectedColor>
                </cntrls:ColorPropertyControl>

                <!--MarkerStrokeThickness (LineSeries and ScatterSeries)-->
                <cntrls:LineWidthSelectorControl
                        Margin="0 2"
                        DockPanel.Dock="Top"
                        Title="Marker Line Thickness"
                        WidthOptions="{StaticResource LineWidthOptions}"
                        SelectedWidth="{Binding Series.MarkerStrokeThickness,
                        ElementName=LineSeriesProperties, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                        PropertyWidth="{Binding ElementName=DummyPropertyControl, Path=ActualPropertyWidth, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ActualToLengthConverter}}"/>

            </DockPanel>

        </Expander>

    </Grid>
</UserControl>
