<UserControl x:Class="OxyPlotControls.SeriesSelectorControl" x:Name="SeriesSelectorRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OxyPlotControls"
             xmlns:cntrls="clr-namespace:GenericControls;assembly=GenericControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/IconResources.xaml"/>
                <ResourceDictionary>
                    <cntrls:VisibilityToBooleanConverter x:Key="VisibilityToBoolConverter" VisibleValue="True" CollapsedValue="False" HiddenValue="False"/>
                    <DataTemplate x:Key="ComboItemWithButtonTemplate">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="0,0,2,0"
                                IsChecked="{Binding Visibility, Converter={StaticResource VisibilityToBoolConverter}}"/>
                            <TextBlock
                                Text="{Binding Title}"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>

                            <Button
                                Margin="5,0,0,0"
                                Grid.Column="2"
                                Height="12"
                                Width="12"
                                Padding="0"
                                SnapsToDevicePixels="True"
                                ToolTip="Move Series Up"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="MoveSeriesUpButton_Click">
                                <Path
                                    Data="M 4,1 4,8 M 1,4 4,1 7,4"
                                    Stroke="Black"
                                    StrokeThickness="2"/>
                            </Button>
                            <Button
                                Margin="5,0,0,0"
                                Grid.Column="3"
                                Height="12"
                                Width="12"
                                Padding="0"
                                SnapsToDevicePixels="True"
                                ToolTip="Move Series Down"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="MoveSeriesDownButton_Click">
                                <Path
                                    Data="M 4,0 4,7 M 1,4 4,7 7,4"
                                    Stroke="Black"
                                    StrokeThickness="2"/>
                            </Button>
                            <!--<Button Margin="5,0,0,0" Grid.Column="4" Height="12" Width="12" Padding="0" SnapsToDevicePixels="True" ToolTip="Delete Series" VerticalAlignment="Center" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Click="DeleteSeriesButton_Click">
                                <Path Data="M 1,1 7,7 M 1,7 7,1" Stroke="Black" StrokeThickness="2"/>
                            </Button>-->
                        </Grid>
                    </DataTemplate>
                    <DataTemplate
                        x:Key="SelectedItemTemplate">
                        <TextBlock
                            Text="{Binding Title}"
                            VerticalAlignment="Center"
                            TextAlignment="Left"/>
                    </DataTemplate>
                    <cntrls:ComboBoxItemTemplateSelector
                        x:Key="itemTemplateSelector"
                        SelectedTemplate="{StaticResource SelectedItemTemplate}"
                        DropDownTemplate="{StaticResource ComboItemWithButtonTemplate}"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto"/>
            <RowDefinition
                Height="*"/>
        </Grid.RowDefinitions>
        <ComboBox
            x:Name="SeriesPropertyControlComboBox"
            Grid.Row="0"
            ItemTemplateSelector="{StaticResource itemTemplateSelector}"
            Style="{Binding ElementName=SeriesSelectorRoot, Path=ComboBoxStyle}"
            HorizontalContentAlignment="Stretch"
            HorizontalAlignment="Stretch"
            MinWidth="60"
            VerticalAlignment="Center"
            FontWeight="Bold"
            BorderThickness="0"
            SelectionChanged="SeriesPropertyControlComboBox_SelectionChanged">
        </ComboBox>

        <!--<Grid>-->
        <local:SeriesControl
            x:Name="SeriesPropertiesControl"
            Margin="0,5,0,0"
            Grid.Row="1" ExpanderStyle="{Binding ElementName=SeriesSelectorRoot, Path=ExpanderStyle}"/>
        <!--</Grid>-->
    </Grid>
</UserControl>
