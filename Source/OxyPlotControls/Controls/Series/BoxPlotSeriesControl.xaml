<UserControl x:Class="OxyPlotControls.Controls.Series.BoxPlotSeriesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OxyPlotControls.Converters"
             x:Name="BoxPlotSeriesControlRoot">
    <UserControl.Resources>
        <converters:OxyColorConverter x:Key="OxyColorConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Expander Header="BOX PLOT SERIES" IsExpanded="True">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefination Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Title:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Series.Title, ElementName=BoxPlotSeriesControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="1" Text="Fill Color:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Series.Fill, ElementName=BoxPlotSeriesControlRoot, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}" Margin="4"/>
                    <TextBlock Grid.Row="2" Text="Stroke:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Series.Stroke, ElementName=BoxPlotSeriesControlRoot, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}" Margin="4"/>
                    <TextBlock Grid.Row="3" Text="Stroke Thickness:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Series.StrokeThickness, ElementName=BoxPlotSeriesControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="4" Text="Box Width:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Series.BoxWidth, ElementName=BoxPlotSeriesControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
