<base:PlotControlBase x:Class="OxyPlotControls.Controls.General.GeneralPlotControl"
             x:Name="GeneralPlotProperties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:base="clr-namespace:OxyPlotControls.Controls.Base"
             xmlns:local="clr-namespace:OxyPlotControls.Controls.General"
             xmlns:converters="clr-namespace:OxyPlotControls.Converters"
             mc:Ignorable="d"
             MinWidth="200"
             MinHeight="100"
             d:DesignHeight="450" d:DesignWidth="800">

    <base:PlotControlBase.Resources>
        <converters:OxyColorConverter x:Key="OxyColorConverter"/>
        <converters:OxyThicknessToDoubleConverter x:Key="ThicknessToDoubleConverter"/>
        <converters:OxyFontSizeConverter x:Key="FontSizeConverter"/>
    </base:PlotControlBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">

            <!-- Plot Title Section -->
            <Expander Header="PLOT TITLE" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title Text -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding Model.Title, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged}"
                             Margin="4"/>

                    <!-- Title Color -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Color:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              SelectedItem="{Binding Model.TitleColor, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}"
                              Margin="4"/>

                    <!-- Title Font -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Font:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              SelectedItem="{Binding Model.TitleFont, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged}"
                              Margin="4"/>

                    <!-- Title Font Size -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Font Size:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding Model.TitleFontSize, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FontSizeConverter}}"
                             Margin="4"/>

                    <!-- Title Font Weight -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Font Weight:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              SelectedItem="{Binding Model.TitleFontWeight, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged}"
                              Margin="4"/>

                    <!-- Title Padding -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Padding:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Text="{Binding Model.TitlePadding, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged}"
                             Margin="4"/>
                </Grid>
            </Expander>

            <!-- Subtitle Section -->
            <Expander Header="SUBTITLE" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Subtitle Text -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtitle:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding Model.Subtitle, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             Margin="4"/>

                    <!-- Subtitle Color -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Color:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              SelectedItem="{Binding Model.SubtitleColor, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}"
                              Margin="4"/>

                    <!-- Subtitle Font -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Font:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              SelectedItem="{Binding Model.SubtitleFont, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged}"
                              Margin="4"/>

                    <!-- Subtitle Font Size -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Font Size:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding Model.SubtitleFontSize, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FontSizeConverter}}"
                             Margin="4"/>

                    <!-- Subtitle Font Weight -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Font Weight:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                              SelectedItem="{Binding Model.SubtitleFontWeight, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged}"
                              Margin="4"/>
                </Grid>
            </Expander>

            <!-- Plot Area Section -->
            <Expander Header="PLOT AREA" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Plot Area Background -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Background:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              SelectedItem="{Binding Model.PlotAreaBackground, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}"
                              Margin="4"/>

                    <!-- Plot Area Border Color -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Border Color:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              SelectedItem="{Binding Model.PlotAreaBorderColor, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}"
                              Margin="4"/>

                    <!-- Plot Area Border Thickness -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Border Thickness:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding Model.PlotAreaBorderThickness, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThicknessToDoubleConverter}}"
                             Margin="4"/>
                </Grid>
            </Expander>

            <!-- Background Section -->
            <Expander Header="BACKGROUND" IsExpanded="True" Margin="0,0,0,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Padding -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Padding:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding Model.Padding, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ThicknessToDoubleConverter}}"
                             Margin="4"/>

                    <!-- Background Color -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Background:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              SelectedItem="{Binding Model.Background, ElementName=GeneralPlotProperties, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}"
                              Margin="4"/>
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</base:PlotControlBase>
