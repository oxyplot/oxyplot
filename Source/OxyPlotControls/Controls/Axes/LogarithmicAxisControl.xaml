<UserControl x:Class="OxyPlotControls.Controls.Axes.LogarithmicAxisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OxyPlotControls.Converters"
             x:Name="LogarithmicAxisControlRoot">
    <UserControl.Resources>
        <converters:OxyColorConverter x:Key="OxyColorConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Expander Header="AXIS PROPERTIES" IsExpanded="True">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Title:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Axis.Title, ElementName=LogarithmicAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="1" Text="Position:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Axis.Position, ElementName=LogarithmicAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="2" Text="Minimum:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Axis.Minimum, ElementName=LogarithmicAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="3" Text="Maximum:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Axis.Maximum, ElementName=LogarithmicAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="4" Text="Major Step:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Axis.MajorStep, ElementName=LogarithmicAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                </Grid>
            </Expander>

            <Expander Header="LOGARITHMIC PROPERTIES" IsExpanded="True" Margin="0,8,0,0">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Base:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LogAxis.Base, ElementName=LogarithmicAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="1" Text="Power Padding:" VerticalAlignment="Center" Margin="0,4"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding LogAxis.PowerPadding, ElementName=LogarithmicAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4" VerticalAlignment="Center"/>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
