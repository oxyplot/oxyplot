<base:AxisControlBase x:Class="OxyPlotControls.Controls.Axes.LinearAxisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:OxyPlotControls.Controls.Base"
             xmlns:converters="clr-namespace:OxyPlotControls.Converters"
             x:Name="LinearAxisControlRoot">
    <base:AxisControlBase.Resources>
        <converters:OxyColorConverter x:Key="OxyColorConverter"/>
    </base:AxisControlBase.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Expander Header="AXIS PROPERTIES" IsExpanded="True">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Title:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Axis.Title, ElementName=LinearAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="1" Text="Position:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Axis.Position, ElementName=LinearAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="2" Text="Minimum:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Axis.Minimum, ElementName=LinearAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="3" Text="Maximum:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Axis.Maximum, ElementName=LinearAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="4" Text="Major Step:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Axis.MajorStep, ElementName=LinearAxisControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</base:AxisControlBase>
