<UserControl x:Class="OxyPlotControls.Controls.Annotations.PolygonAnnotationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OxyPlotControls.Converters"
             x:Name="PolygonAnnotationControlRoot">
    <UserControl.Resources>
        <converters:OxyColorConverter x:Key="OxyColorConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Expander Header="POLYGON ANNOTATION" IsExpanded="True">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Text:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Annotation.Text, ElementName=PolygonAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="1" Text="Fill:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Annotation.Fill, ElementName=PolygonAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}" Margin="4"/>
                    <TextBlock Grid.Row="2" Text="Stroke:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Annotation.Stroke, ElementName=PolygonAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}" Margin="4"/>
                    <TextBlock Grid.Row="3" Text="Stroke Thickness:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Annotation.StrokeThickness, ElementName=PolygonAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="4" Text="Points:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="4" Text="Edit points interactively on plot" FontStyle="Italic"/>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
