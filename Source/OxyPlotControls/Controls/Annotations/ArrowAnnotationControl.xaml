<UserControl x:Class="OxyPlotControls.Controls.Annotations.ArrowAnnotationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OxyPlotControls.Converters"
             x:Name="ArrowAnnotationControlRoot">
    <UserControl.Resources>
        <converters:OxyColorConverter x:Key="OxyColorConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Expander Header="ARROW ANNOTATION" IsExpanded="True">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Text:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Annotation.Text, ElementName=ArrowAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="1" Text="Color:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Annotation.Color, ElementName=ArrowAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}" Margin="4"/>
                    <TextBlock Grid.Row="2" Text="Thickness:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Annotation.StrokeThickness, ElementName=ArrowAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="3" Text="Head Length:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Annotation.HeadLength, ElementName=ArrowAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4" ToolTip="Relative to stroke thickness (default: 10)"/>
                    <TextBlock Grid.Row="4" Text="Head Width:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Annotation.HeadWidth, ElementName=ArrowAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4" ToolTip="Relative to stroke thickness (default: 3)"/>
                    <TextBlock Grid.Row="5" Text="Line Style:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" SelectedItem="{Binding Annotation.LineStyle, ElementName=ArrowAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
