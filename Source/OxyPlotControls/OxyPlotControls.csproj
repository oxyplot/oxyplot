<!-- OxyPlotControls - Modern C# WPF Controls for OxyPlot -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>OxyPlotControls</RootNamespace>
    <AssemblyName>OxyPlotControls</AssemblyName>
    <Authors>USACE-RMC</Authors>
    <Description>WPF controls for editing and configuring OxyPlot charts. Provides property editors for series, axes, annotations, and general plot settings.</Description>
    <Copyright>Copyright © USACE-RMC 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OxyPlot\OxyPlot.csproj" />
    <ProjectReference Include="..\OxyPlot.Wpf\OxyPlot.Wpf.csproj" />
  </ItemGroup>

  <!-- GenericControls reference for net9.0 -->

  <!-- DatabaseManager reference for net9.0 -->

  <!-- Resource files -->
  <ItemGroup>
    <Resource Include="Resources\*.cur" />
    <Resource Include="Resources\*.png" />
    <Resource Include="Resources\*.ico" />
  </ItemGroup>

  <!-- XAML resource dictionaries -->
  <ItemGroup>
    <Page Include="Expander\ExpanderStyle.xaml" />
    <Page Include="Resources\IconResources.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="DatabaseManager">
      <HintPath>..\..\..\database-management\DatabaseManager\bin\Debug\net9.0\DatabaseManager.dll</HintPath>
    </Reference>
    <Reference Include="GenericControls">
      <HintPath>..\..\..\wpf-framework\src\GenericControls\bin\Debug\net9.0-windows\GenericControls.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
