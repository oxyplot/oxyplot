<UserControl x:Class="OxyPlotControls.OxyplotPropertiesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:general="clr-namespace:OxyPlotControls.Controls.General"
             xmlns:legend="clr-namespace:OxyPlotControls.Controls.Legend"
             xmlns:selectors="clr-namespace:OxyPlotControls.Controls.Selectors"
             x:Name="PropertiesControlRoot"
             MinWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Section Selector and Close Button -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Property Section Selector -->
            <ComboBox x:Name="PropertySectionComboBox"
                      Grid.Column="0"
                      SelectedIndex="0"
                      FontWeight="Bold"
                      FontSize="12"
                      SelectionChanged="PropertySectionComboBox_SelectionChanged"
                      ToolTip="Select property section to edit">
                <ComboBoxItem Content="GENERAL PLOT SETTINGS" Tag="General"/>
                <ComboBoxItem Content="LEGEND" Tag="Legend"/>
                <ComboBoxItem Content="AXES" Tag="Axes"/>
                <ComboBoxItem Content="SERIES" Tag="Series"/>
                <ComboBoxItem Content="ANNOTATIONS" Tag="Annotations"/>
            </ComboBox>

            <!-- Close Button -->
            <Button x:Name="ClosePropertiesButton"
                    Grid.Column="1"
                    Content="✕"
                    Width="24"
                    Height="24"
                    Margin="4,0,0,0"
                    Padding="0"
                    FontWeight="Bold"
                    ToolTip="Close properties panel"
                    Click="ClosePropertiesButton_Click"
                    Visibility="{Binding ShowCloseButton, ElementName=PropertiesControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- Property Editor Container with Lazy Loading -->
        <ScrollViewer x:Name="ControlScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="PropertyContentGrid">
                <!-- Controls are created lazily in code-behind -->
            </Grid>
        </ScrollViewer>
    </Grid>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
</UserControl>
