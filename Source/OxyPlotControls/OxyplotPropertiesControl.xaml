<UserControl x:Class="OxyPlotControls.OxyplotPropertiesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:general="clr-namespace:OxyPlotControls.Controls.General"
             xmlns:legend="clr-namespace:OxyPlotControls.Controls.Legend"
             xmlns:selectors="clr-namespace:OxyPlotControls.Controls.Selectors"
             x:Name="PropertiesControlRoot"
             MinWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Property Section Selector -->
        <ComboBox x:Name="PropertySectionComboBox"
                  Grid.Row="0"
                  Margin="8,8,8,4"
                  SelectedIndex="0"
                  FontWeight="Bold"
                  FontSize="12"
                  SelectionChanged="PropertySectionComboBox_SelectionChanged"
                  ToolTip="Select property section to edit">
            <ComboBoxItem Content="GENERAL PLOT SETTINGS" Tag="General"/>
            <ComboBoxItem Content="LEGEND" Tag="Legend"/>
            <ComboBoxItem Content="AXES" Tag="Axes"/>
            <ComboBoxItem Content="SERIES" Tag="Series"/>
            <ComboBoxItem Content="ANNOTATIONS" Tag="Annotations"/>
        </ComboBox>

        <!-- Property Editor Container -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="PropertyContentGrid">
                <!-- General Plot Settings -->
                <general:GeneralPlotControl x:Name="GeneralControl"
                                           Model="{Binding Model, ElementName=PropertiesControlRoot}"
                                           Visibility="Visible"/>

                <!-- Legend Settings -->
                <legend:LegendControl x:Name="LegendControl"
                                     Model="{Binding Model, ElementName=PropertiesControlRoot}"
                                     Visibility="Collapsed"/>

                <!-- Axes Selector -->
                <selectors:AxesControl x:Name="AxesControl"
                                      Model="{Binding Model, ElementName=PropertiesControlRoot}"
                                      Visibility="Collapsed"/>

                <!-- Series Selector -->
                <selectors:SeriesSelectorControl x:Name="SeriesControl"
                                                Model="{Binding Model, ElementName=PropertiesControlRoot}"
                                                Visibility="Collapsed"/>

                <!-- Annotations Selector -->
                <selectors:AnnotationSelectorControl x:Name="AnnotationsControl"
                                                     Model="{Binding Model, ElementName=PropertiesControlRoot}"
                                                     Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
