<UserControl x:Class="OxyPlotControls.OxyplotPropertiesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:general="clr-namespace:OxyPlotControls.Controls.General"
             xmlns:legend="clr-namespace:OxyPlotControls.Controls.Legend"
             xmlns:selectors="clr-namespace:OxyPlotControls.Controls.Selectors"
             x:Name="PropertiesControlRoot"
             MinWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OxyPlotControls;component/Styles/OxyPlotStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding ElementName=BackButton, Path=Width}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Back/Close Button -->
        <Button x:Name="BackButton"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0"
                SnapsToDevicePixels="True"
                ToolTip="Close Plot Properties"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderBrush="Transparent"
                Style="{Binding ElementName=PropertiesControlRoot, Path=BackButtonStyle}"
                Visibility="{Binding ShowCloseButton, ElementName=PropertiesControlRoot, Converter={StaticResource BooleanToVisibilityConverter}}"
                Click="ClosePropertiesButton_Click">
            <StackPanel Orientation="Horizontal">
                <Path Data="M 1,5 5,9 M 1,5 5,1 M 0,5 11,5"
                      Stroke="Black"
                      StrokeThickness="2"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Margin="4"/>
            </StackPanel>
        </Button>

        <!-- Property Editor Container with Lazy Loading -->
        <ScrollViewer x:Name="ControlScrollViewer"
                      Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <Grid x:Name="PropertyContentGrid" Margin="0,5,0,0">
                <!-- Controls are created lazily in code-behind -->
            </Grid>
        </ScrollViewer>

        <!-- Property Section Selector -->
        <ComboBox x:Name="PropertySectionComboBox"
                  Grid.Row="0"
                  Grid.Column="1"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  SelectedIndex="0"
                  ToolTip="Click to Select Plot Component"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  Margin="0"
                  FontSize="12"
                  FontWeight="Bold"
                  BorderThickness="0"
                  Style="{Binding ElementName=PropertiesControlRoot, Path=PropertyControlComboBoxStyle}"
                  SelectionChanged="PropertySectionComboBox_SelectionChanged">
            <ComboBoxItem Content="GENERAL PLOT SETTINGS" Tag="General" HorizontalContentAlignment="Left" FontSize="12"/>
            <ComboBoxItem Content="LEGEND" Tag="Legend" HorizontalContentAlignment="Left" FontSize="12"/>
            <ComboBoxItem Content="AXES" Tag="Axes" HorizontalContentAlignment="Left" FontSize="12"/>
            <ComboBoxItem Content="SERIES" Tag="Series" HorizontalContentAlignment="Left" FontSize="12"/>
            <ComboBoxItem Content="ANNOTATIONS" Tag="Annotations" HorizontalContentAlignment="Left" FontSize="12"/>
        </ComboBox>
    </Grid>
</UserControl>
