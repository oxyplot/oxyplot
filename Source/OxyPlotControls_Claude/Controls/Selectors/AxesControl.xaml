<UserControl x:Class="OxyPlotControls.Controls.Selectors.AxesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="AxesControlRoot">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Axes Selector and Management -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Axes Selector ComboBox -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Select Axis:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AxesComboBox"
                          Grid.Column="1"
                          SelectionChanged="AxesComboBox_SelectionChanged"
                          ToolTip="Select an axis to edit its properties">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                <Run Text=" (" Foreground="Gray"/>
                                <Run Text="{Binding Position, Mode=OneWay}" Foreground="Gray"/>
                                <Run Text=")" Foreground="Gray"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Axes Management Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+ Add" Click="AddAxis_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Add a new axis">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Linear Axis" Click="AddLinearAxis_Click"/>
                            <MenuItem Header="Logarithmic Axis" Click="AddLogarithmicAxis_Click"/>
                            <MenuItem Header="DateTime Axis" Click="AddDateTimeAxis_Click"/>
                            <MenuItem Header="Category Axis" Click="AddCategoryAxis_Click"/>
                            <Separator/>
                            <MenuItem Header="Normal Probability Axis" Click="AddNormalProbabilityAxis_Click"/>
                            <MenuItem Header="Gumbel Probability Axis" Click="AddGumbelProbabilityAxis_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="✗ Delete" Click="DeleteAxis_Click" Padding="8,4" ToolTip="Delete selected axis"/>
            </StackPanel>
        </Grid>

        <!-- Axis Property Editor -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="AxisPropertyEditor" Margin="8"/>
        </ScrollViewer>
    </Grid>
</UserControl>
