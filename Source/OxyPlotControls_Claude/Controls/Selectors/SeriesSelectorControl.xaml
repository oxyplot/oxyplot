<UserControl x:Class="OxyPlotControls.Controls.Selectors.SeriesSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SeriesSelectorRoot">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Series Selector and Management -->
        <Grid Grid.Row="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Series Selector ComboBox -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Select Series:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SeriesComboBox"
                          Grid.Column="1"
                          DisplayMemberPath="Title"
                          SelectionChanged="SeriesComboBox_SelectionChanged"
                          ToolTip="Select a series to edit its properties"/>
            </Grid>

            <!-- Series Management Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="↑ Move Up" Click="MoveUp_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Move series up in render order"/>
                <Button Content="↓ Move Down" Click="MoveDown_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Move series down in render order"/>
                <Button Content="+ Add" Click="AddSeries_Click" Padding="8,4" Margin="0,0,4,0" ToolTip="Add a new series">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Line Series" Click="AddLineSeries_Click"/>
                            <MenuItem Header="Bar Series" Click="AddBarSeries_Click"/>
                            <MenuItem Header="Column Series" Click="AddColumnSeries_Click"/>
                            <MenuItem Header="Scatter Series" Click="AddScatterSeries_Click"/>
                            <MenuItem Header="Area Series" Click="AddAreaSeries_Click"/>
                            <MenuItem Header="Pie Series" Click="AddPieSeries_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="✗ Delete" Click="DeleteSeries_Click" Padding="8,4" ToolTip="Delete selected series"/>
            </StackPanel>
        </Grid>

        <!-- Series Property Editor -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="SeriesPropertyEditor" Margin="8"/>
        </ScrollViewer>
    </Grid>
</UserControl>
