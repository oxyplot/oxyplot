<base:AnnotationControlBase x:Class="OxyPlotControls.Controls.Annotations.PointAnnotationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:OxyPlotControls.Controls.Base"
             xmlns:converters="clr-namespace:OxyPlotControls.Converters"
             x:Name="PointAnnotationControlRoot">
    <base:AnnotationControlBase.Resources>
        <converters:OxyColorConverter x:Key="OxyColorConverter"/>
    </base:AnnotationControlBase.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Expander Header="POINT ANNOTATION" IsExpanded="True">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Text:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Annotation.Text, ElementName=PointAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="1" Text="X:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Annotation.X, ElementName=PointAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="2" Text="Y:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Annotation.Y, ElementName=PointAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="3" Text="Size:" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Annotation.Size, ElementName=PointAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="4" Text="Shape:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Annotation.Shape, ElementName=PointAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                    <TextBlock Grid.Row="5" Text="Fill:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" SelectedItem="{Binding Annotation.Fill, ElementName=PointAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}" Margin="4"/>
                    <TextBlock Grid.Row="6" Text="Stroke:" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" SelectedItem="{Binding Annotation.Stroke, ElementName=PointAnnotationControlRoot, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource OxyColorConverter}}" Margin="4"/>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</base:AnnotationControlBase>
